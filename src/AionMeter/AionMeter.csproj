<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AionMeter</RootNamespace>
    <AssemblyName>AionMeter</AssemblyName>
    <!-- Sürüm: release etiketi v<Version>. Güncelleyici bunu AssemblyInformationalVersion'dan okur. -->
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- Manifest'teki DPI ayarı bilinçli: pencere yaratılmadan önce, en erken anda geçerli olsun. -->
    <NoWarn>$(NoWarn);WFO0003;WFAC010</NoWarn>

    <!-- Düşük bellek -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Sadece "dotnet publish" sırasında: tek, self-contained exe. Kırpma (trimming) WinForms'ta desteklenmez, kapalı. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sıkıştırma kapalı: açıkken kütüphaneler RAM'e açılıyor, ~60 MB fazla bellek (ölçüldü). Zip zaten sıkıştırıyor. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AionMeter.Abstractions\AionMeter.Abstractions.csproj" />
    <ProjectReference Include="..\AionMeter.Core\AionMeter.Core.csproj" />
  </ItemGroup>

  <!-- Motorun okuduğu veri dosyaları exe'nin yanına assets\aion2\ olarak kopyalanır (oyun yamasında sadece bunlar güncellenir). -->
  <ItemGroup>
    <None Include="..\..\assets\aion2\**\*.json" Link="assets\aion2\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Beceri ikonları (48x48 PNG): detay paneli açıkken diskten tembel okunur, exe'ye gömülmez. -->
    <None Include="..\..\assets\aion2\skills\icons\**\*.png" Link="assets\aion2\skills\icons\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="docs\**" />
    <!-- Sınıf ikonları exe'ye gömülür (tek exe taşınabilir kalsın). Ad: sinif.<Sınıf>.png -->
    <EmbeddedResource Include="Resources\classes\*.png" LogicalName="sinif.%(Filename).png" />
  </ItemGroup>

</Project>
